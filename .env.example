# ── 서버 ──────────────────────────────────────────────────────────────────────
SERVER_HOST=127.0.0.1
SERVER_PORT=5200
LOG_LEVEL=INFO

# ── 저장 ──────────────────────────────────────────────────────────────────────
# DB_PATH=data/news.db
# 소스별 retention_days 가 없을 때의 보관 기간(일)
DEFAULT_RETENTION_DAYS=365
# 일일 백업 보관 개수 (0 이면 백업 안 함)
BACKUP_KEEP=3

# ── 공시 소스 자격 증명 (없으면 해당 소스는 '미설정'으로 건너뜀) ──────────────
# OpenDART 인증키 — https://opendart.fss.or.kr
DART_API_KEY=
# SEC 는 연락처가 담긴 User-Agent 를 요구한다. 예: "MyName admin@example.com"
EDGAR_USER_AGENT=

# ── 보안 (선택) ───────────────────────────────────────────────────────────────
# 설정하면 쓰기 요청(PATCH/POST/PUT/DELETE)에 Authorization: Bearer <토큰> 필요
API_TOKEN=

# ── 상태 경보 (선택) ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
