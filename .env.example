# ── 서버 ──────────────────────────────────────────────────────────────────────
# 127.0.0.1: 이 머신에서만 접근 / 0.0.0.0: LAN 공개 (이 경우 API_TOKEN 설정 권장)
SERVER_HOST=127.0.0.1
SERVER_PORT=5200
LOG_LEVEL=INFO

# ── 저장 ──────────────────────────────────────────────────────────────────────
# DB_PATH=data/news.db
# 소스별 retention_days 가 없을 때의 보관 기간(일)
DEFAULT_RETENTION_DAYS=365
# 일일 백업 보관 개수 (0 이면 백업 안 함)
BACKUP_KEEP=3

# ── 공시 소스 자격 증명 (없으면 해당 소스는 '미설정'으로 건너뜀) ──────────────
# OpenDART 인증키 — https://opendart.fss.or.kr
DART_API_KEY=
# SEC 는 연락처가 담긴 User-Agent 를 요구한다. 예: "MyName admin@example.com"
EDGAR_USER_AGENT=

# ── 보안 (선택) ───────────────────────────────────────────────────────────────
# 설정하면 쓰기 요청(PATCH/POST/PUT/DELETE)에 Authorization: Bearer <토큰> 필요.
# 운영 콘솔(/)에서는 우측 상단 '토큰' 버튼으로 입력한다. 생성 예: python3 -c "import secrets;print(secrets.token_urlsafe(24))"
API_TOKEN=

# ── 상태 경보 (선택) ──────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── 재무제표 조회 (선택) ──────────────────────────────────────────────────────
# 원천(DART·SEC) 응답을 프로세스 메모리에만 두는 시간(초)과 항목 수. 디스크에 저장하지 않는다.
# FINANCIALS_CACHE_TTL_SEC=43200
# FINANCIALS_CACHE_MAX_ENTRIES=512
